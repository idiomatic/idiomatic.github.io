alias tb='awk "!/inventory$/{\$1=int(\$1/1024)/1000;print}"'

dvdrip() { stage=$(mktemp -u "$HOME/Videos/$1.iso.XXXXXX") dest="/mnt/rip/Video/DVD Rip/$1.iso" uniqdest="${dest%/*}/${stage##*/}" ; while ! blkid -o value -s LABEL /dev/sr${disc:-0} ; do sleep 1 ; done && flatpak run --command=/app/bin/makemkvcon com.makemkv.MakeMKV --noscan backup --decrypt disc:${disc:-0} "$stage" && eject /dev/sr${disc:-0} && mv -vi "$stage" "$uniqdest" && mv -nvT "$uniqdest" "$dest" ; }
bdrip() { stage=$(mktemp -u "$HOME/Videos/$1.XXXXXX") dest="/mnt/rip/Video/Blu-ray Rip/$1" uniqdest="${dest%/*}/${stage##*/}" ; while ! blkid -o value -s LABEL /dev/sr${disc:-0} ; do sleep 1 ; done && mkdir -p "$stage" && flatpak run --command=/app/bin/makemkvcon com.makemkv.MakeMKV --noscan mkv disc:${disc:-0} all "$stage" && eject /dev/sr${disc:-0} && mv -vi "$stage" "$uniqdest" && mv -nvT "$uniqdest" "$dest" ; }
uhdrip() { stage=$(mktemp -u "$HOME/Videos/$1.XXXXXX") dest="/mnt/rip/Video/Ultra HD Blu-ray Rip/$1" uniqdest="${dest%/*}/${stage##*/}" ; while ! blkid -o value -s LABEL /dev/sr${disc:-0} ; do sleep 1 ; done && mkdir -p "$stage" && flatpak run --command=/app/bin/makemkvcon com.makemkv.MakeMKV --noscan mkv disc:${disc:-0} all "$stage" && eject /dev/sr${disc:-0} && mv -vi "$stage" "$uniqdest" && mv -nvT "$uniqdest" "$dest" ; }
dvdripforever() { destdir="/mnt/rip/Video/DVD Rip" spinner='-\|/' i=0 ; while true ; do i=$(((i+1)%4)) ; printf "%c waiting\r" "${spinner:$i:1}" ; if title=$(blkid -o value -s LABEL /dev/sr${disc:-0}) ; then title="${title//_/ }" title=${title:-DVD} stage=$(mktemp -u "$HOME/Videos/$title.iso.XXXXXX") dest="$destdir/$title.iso" uniqdest="${dest%/*}/${stage##*/}" && flatpak run --command=/app/bin/makemkvcon com.makemkv.MakeMKV --noscan backup --decrypt disc:${disc:-0} "$stage" && eject /dev/sr${disc:-0} && mv -vi "$stage" "$uniqdest" && mv -nv "$uniqdest" "$dest" ; fi ; sleep 2 ; done ; }
